[Unit]
Description=Raspberry Pi Internet Radio
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi-radio
Group=pi-radio
SupplementaryGroups=audio
ExecStart=/usr/bin/mpv --no-config --idle=yes --no-video --no-terminal --audio-display=no --ad=aac_fixed --volume=50 --input-ipc-server=/run/pi-radio/mpv.sock
Restart=on-failure
RestartSec=2
RuntimeDirectory=pi-radio
RuntimeDirectoryMode=0770
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
