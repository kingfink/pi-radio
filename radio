#!/bin/sh

set -eu

WOODSTOCK_HLS_URL=https://stream.revma.ihrhls.com/zc7332/hls.m3u8
WOODSTOCK_DIRECT_URL=https://stream.revma.ihrhls.com/zc7332

HOST_OS=$(uname -s)

case "$HOST_OS" in
    Linux)
        SOCKET=${PI_RADIO_SOCKET:-/run/pi-radio/mpv.sock}
        RESTART_HINT="sudo systemctl restart radio"
        ;;
    Darwin)
        SOCKET=${PI_RADIO_SOCKET:-$HOME/Library/Caches/pi-radio/mpv.sock}
        RESTART_HINT="launchctl kickstart -k gui/$(id -u)/com.kingfink.pi-radio"
        ;;
    *)
        echo "Unsupported operating system." >&2
        exit 1
        ;;
esac

usage() {
    echo "Usage: radio {play [station]|stop|status|volume [0-100|up|down]|stations|help}" >&2
    exit 1
}

help() {
    echo "Usage:"
    echo "  radio play [station]"
    echo "  radio stop"
    echo "  radio status"
    echo "  radio volume [0-100|up|down]"
    echo "  radio stations"
    echo "  radio help"
}

require_socket() {
    if [ ! -S "$SOCKET" ]; then
        echo "Radio service is not ready. Try: $RESTART_HINT" >&2
        exit 1
    fi

    case "$HOST_OS" in
        Linux)
            if ! command -v socat >/dev/null 2>&1; then
                echo "socat is not installed. Rerun the installer." >&2
                exit 1
            fi
            ;;
        Darwin)
            if ! command -v nc >/dev/null 2>&1; then
                echo "nc is not installed." >&2
                exit 1
            fi
            ;;
    esac
}

request() {
    case "$HOST_OS" in
        Linux) printf '%s\n' "$1" | socat -T2 - "UNIX-CONNECT:$SOCKET" ;;
        Darwin) printf '%s\n' "$1" | nc -w 2 -U "$SOCKET" ;;
    esac
}

json_string_data() {
    printf '%s\n' "$1" \
        | sed -n 's/.*"data":[[:space:]]*"\(.*\)"[[:space:]]*,[[:space:]]*"request_id".*/\1/p' \
        | sed 's/\\"/"/g; s/\\\\/\\/g'
}

get_volume() {
    RESPONSE=$(request '{"command":["get_property_string","volume"]}')
    json_string_data "$RESPONSE" | sed 's/\..*$//'
}

now_playing() {
    TITLE_RESPONSE=$(request '{"command":["get_property_string","metadata/by-key/title"]}')
    ARTIST_RESPONSE=$(request '{"command":["get_property_string","metadata/by-key/artist"]}')
    TITLE=$(json_string_data "$TITLE_RESPONSE")
    ARTIST=$(json_string_data "$ARTIST_RESPONSE")

    if [ -n "$TITLE" ]; then
        if [ -n "$ARTIST" ]; then
            echo "$ARTIST — $TITLE"
        else
            echo "$TITLE"
        fi
        return
    fi

    ICY_RESPONSE=$(request '{"command":["get_property_string","metadata/by-key/icy-title"]}')
    ICY_TITLE=$(json_string_data "$ICY_RESPONSE")
    printf '%s\n' "$ICY_TITLE" \
        | sed 's#[[:space:]]*https\{0,1\}://[^[:space:]]*[[:space:]]*$##' \
        | sed 's/ - text="\([^"]*\)"$/ — \1/'
}

COMMAND=${1:-}

case "$COMMAND" in
    play)
        [ "$#" -le 2 ] || usage
        require_socket
        STATION=${2:-woodstock}
        case "$STATION" in
            woodstock) STREAM_URL=${PI_RADIO_STREAM_URL:-$WOODSTOCK_HLS_URL} ;;
            *)
                echo "Unknown station: $STATION" >&2
                echo "Try: radio stations" >&2
                exit 1
                ;;
        esac
        request "{\"command\":[\"loadfile\",\"$STREAM_URL\",\"replace\"]}" >/dev/null
        ;;
    stop)
        [ "$#" -eq 1 ] || usage
        require_socket
        request '{"command":["stop"]}' >/dev/null
        ;;
    volume)
        require_socket
        [ "$#" -le 2 ] || usage
        CURRENT_VOLUME=$(get_volume)
        [ -n "$CURRENT_VOLUME" ] || {
            echo "Volume is unavailable." >&2
            exit 1
        }

        if [ "$#" -eq 2 ]; then
            case "$2" in
                up)
                    VOLUME=$((CURRENT_VOLUME + 5))
                    [ "$VOLUME" -le 100 ] || VOLUME=100
                    ;;
                down)
                    VOLUME=$((CURRENT_VOLUME - 5))
                    [ "$VOLUME" -ge 0 ] || VOLUME=0
                    ;;
                ''|*[!0-9]*) usage ;;
                *)
                    VOLUME=$2
                    [ "$VOLUME" -le 100 ] || usage
                    ;;
            esac
            request "{\"command\":[\"set_property\",\"volume\",$VOLUME]}" >/dev/null
            CURRENT_VOLUME=$(get_volume)
        fi

        echo "volume $CURRENT_VOLUME"
        ;;
    status)
        [ "$#" -eq 1 ] || usage
        require_socket
        IDLE_RESPONSE=$(request '{"command":["get_property","idle-active"]}')
        COMPACT_IDLE=$(printf '%s' "$IDLE_RESPONSE" | tr -d '[:space:]')
        VOLUME=$(get_volume)

        case "$COMPACT_IDLE" in
            *'"data":true'*) STATE=stopped ;;
            *'"data":false'*) STATE=playing ;;
            *) STATE=unknown ;;
        esac

        OUTPUT=$STATE

        if [ "$STATE" = playing ]; then
            PATH_RESPONSE=$(request '{"command":["get_property_string","path"]}')
            STREAM_PATH=$(json_string_data "$PATH_RESPONSE")
            case "$STREAM_PATH" in
                "$WOODSTOCK_HLS_URL"|"$WOODSTOCK_DIRECT_URL") STATION_NAME="Radio Woodstock" ;;
                *) STATION_NAME=custom ;;
            esac

            TRACK=$(now_playing)
            [ -n "$TRACK" ] || TRACK="track unavailable"
            OUTPUT="$OUTPUT | $STATION_NAME | $TRACK"
        fi

        [ -z "$VOLUME" ] || OUTPUT="$OUTPUT | volume $VOLUME"
        echo "$OUTPUT"
        ;;
    stations)
        [ "$#" -eq 1 ] || usage
        echo "woodstock  Radio Woodstock (default)"
        ;;
    help|-h|--help)
        [ "$#" -eq 1 ] || usage
        help
        ;;
    *)
        usage
        ;;
esac
